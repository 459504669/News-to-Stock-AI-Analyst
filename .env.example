# 环境变量配置模板
# 复制此文件为 .env 并填入真实值

# ============ LLM 配置 ============
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 阿里通义千问
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 百度文心一言
WENXIN_API_KEY=your_wenxin_api_key_here
WENXIN_SECRET_KEY=your_wenxin_secret_key_here

# 默认 LLM 提供商 (openai / anthropic / qwen / wenxin)
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# ============ 数据库配置 ============
# SQLite (默认，无需额外配置)
DATABASE_URL=sqlite+aiosqlite:///./data/news_analyst.db

# PostgreSQL (可选，生产环境推荐)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/news_analyst

# ============ 新闻采集配置 ============
# 启用的新闻源 (逗号分隔)
ENABLED_NEWS_SOURCES=cailianshe,sina_finance,eastmoney,reuters,bloomberg

# 新闻抓取间隔 (秒)
NEWS_FETCH_INTERVAL=300

# 新闻历史保留天数
NEWS_RETENTION_DAYS=30

# ============ 服务配置 ============
# API 服务端口
API_PORT=8000
API_HOST=0.0.0.0

# ============ 可视化配置 ============
# 图片输出主题 (light / dark)
IMAGE_THEME=light
IMAGE_WIDTH=1200
IMAGE_HEIGHT=1600
IMAGE_OUTPUT_DIR=./output/images

# ============ Redis (可选，用于 Celery 任务队列) ============
REDIS_URL=redis://localhost:6379/0

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_DIR=./logs
